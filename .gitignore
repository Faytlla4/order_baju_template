!application/modules/report_excel/**
!application/modules/report_pdf/
!application/modules/report_pdf/**
!application/modules/sk_tidak_mampu/
!application/modules/sk_tidak_mampu/**
!application/modules/transaksi/
!application/modules/transaksi/**

# Remove PHPStorm Project folders
bonfire/.ideas
.idea/*

# Ignore the installed.txt file
public/install/installed.txt

# Ignore any composer downloaded packages
vendor/*

# Ignore any sparks that have been loaded
sparks/*

# --- Security: sensitive files ---
*.sql
!database/schema.sql
*.dump
*.sqlite
*.sqlite3
.env
.env.*
!*.env.example
cookies.txt
cookies*.txt
uploads/*
!uploads/index.html
application/config/database.php
public/install/installed.txt

# Backup ZIP files (generated by backup module)
application/uploads/backup/*.zip
application/uploads/backup/tmp/
application/uploads/backup/*.sql

# Log files
*.log

# OS generated files
Thumbs.db
Desktop.ini
._*
.DS_Store

