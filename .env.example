# ===========================================
# Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# NEVER commit .env to version control!
# ===========================================

# --- Environment (used by public/index.php) ---
# development | testing | production
CI_ENV=development

# --- Database ---
DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=nama_db
DB_DRIVER=postgre
DB_DEBUG=false

# --- Application ---
# APP_BASE_URL harus diakhiri slash dan sesuai DocumentRoot/project.
# Contoh XAMPP subfolder: http://localhost/order_baju_template/public/
# Contoh Laragon vhost   : http://apktemplate.test/
APP_BASE_URL=http://localhost/order_baju_template/public/
# 32 karakter hex. Generate: php -r "echo bin2hex(random_bytes(16));"
APP_ENCRYPTION_KEY=

# --- Backup ---
# Set to 1 to skip test restore (faster, ~5s vs ~50s)
BACKUP_SKIP_TEST=0
